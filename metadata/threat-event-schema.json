{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CryptoSHIELD threat event 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "timestamp",
    "threat_id",
    "category",
    "severity",
    "ooda_phase",
    "evidence_status",
    "attribution_status",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "threat_id": {
      "type": "string",
      "pattern": "^CS-[A-Z]{2,4}-[0-9]{2}$"
    },
    "category": {
      "enum": [
        "Physical",
        "Insider",
        "Social Engineering",
        "Malware",
        "Wallet",
        "DeFi Protocol",
        "Supply Chain",
        "AI Agent",
        "Market Manipulation",
        "Financial Fraud",
        "Sovereignty",
        "Extortion"
      ]
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "ooda_phase": {
      "enum": [
        "observe",
        "orient",
        "decide",
        "act",
        "all"
      ]
    },
    "evidence_status": {
      "enum": [
        "synthetic",
        "reported",
        "primary_reviewed"
      ]
    },
    "attribution_status": {
      "enum": [
        "unknown",
        "reported",
        "assessed"
      ]
    },
    "attribution": {
      "type": [
        "string",
        "null"
      ]
    },
    "insider_vector": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "ai_assisted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "financial_loss_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Direct loss only; null if unknown. Do not merge affected, frozen, recovered, or reimbursed amounts."
    },
    "financial_loss_estimated": {
      "type": "boolean"
    },
    "candidate_controls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2,4}-[0-9]{2}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    },
    "control_analysis": {
      "type": "string",
      "description": "Proposed mechanism, assumptions, bypasses, controls present, and residual harm. No counterfactual prevention guarantee."
    },
    "chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "transaction_hashes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "wallet_addresses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "financial_effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "affected_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "frozen_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "seized_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "returned_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reimbursed_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "schema_version": {
      "const": "2.0"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence_status": {
            "enum": [
              "reported",
              "primary_reviewed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "references": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "attribution_status"
        ],
        "properties": {
          "attribution_status": {
            "enum": [
              "reported",
              "assessed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "attribution"
        ],
        "properties": {
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "references": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
